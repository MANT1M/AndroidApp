                <span><strong class="font-bold text-emerald-300">Миләди:</strong> 8 ноября 2026 г.</span>
                <span class="text-emerald-400/90 font-bold">•</span>
                <span class="font-bold text-white tracking-wide">Якшәмбе</span>
                <span class="text-emerald-400/90 font-bold">•</span>
                <span><strong class="font-bold text-amber-300">Һиҗри:</strong> 27 Җөмадиәл-әүвәл 1448 г.х.</span>
              </div>
            </div>

            <!-- Frosted live countdown pill -->
            <div class="flex items-center gap-2.5 px-3.5 py-1.5 rounded-xl bg-white/10 border border-white/25 backdrop-blur-xl text-xs self-start shadow-lg">
              <div class="flex flex-col text-right">
                <span class="text-[9px] uppercase tracking-wider font-bold text-amber-300">Киләсе: Ястү (Иша)</span>
                <span class="font-extrabold text-white tabular-time tracking-tight text-sm live-timer">00:34:12</span>
              </div>
              <span class="w-2.5 h-2.5 rounded-full bg-amber-400 animate-ping"></span>
            </div>
          </div>
        </div>

        <!-- 6 Frosted Glass Cards in One Single Row -->
        <div class="mt-4 sm:mt-5 sm:px-2 relative z-10">
          <div class="inner-capsule-frosted rounded-2xl sm:rounded-3xl p-2 sm:p-2.5 overflow-x-auto no-scrollbar">
            <div class="grid grid-cols-6 gap-1.5 sm:gap-2.5 min-w-[560px] sm:min-w-0">
              
              <!-- 1. ИРТӘНГЕ -->
              <div class="card-frosted flex flex-col justify-between items-center text-center py-2.5 px-1 sm:py-3.5 sm:px-2 rounded-xl sm:rounded-2xl">
                <div>
                  <div class="text-[11px] sm:text-[13px] md:text-sm font-black uppercase text-white tracking-wider drop-shadow-sm">ИРТӘНГЕ</div>
                  <div class="text-[10px] sm:text-xs text-slate-300 font-medium mt-0.5">Фаджр</div>
                </div>
                <div class="text-base sm:text-xl md:text-2xl font-extrabold text-white tabular-time mt-3 drop-shadow">06:53</div>
              </div>

              <!-- 2. КОЯШ -->
              <div class="card-frosted flex flex-col justify-between items-center text-center py-2.5 px-1 sm:py-3.5 sm:px-2 rounded-xl sm:rounded-2xl">
                <div>
                  <div class="text-[11px] sm:text-[13px] md:text-sm font-black uppercase text-white tracking-wider drop-shadow-sm">КОЯШ</div>
                  <div class="text-[10px] sm:text-xs text-slate-300 font-medium mt-0.5">Шурук</div>
                </div>
                <div class="text-base sm:text-xl md:text-2xl font-extrabold text-slate-100 tabular-time mt-3 drop-shadow">08:33</div>
              </div>

              <!-- 3. ӨЙЛӘ -->
              <div class="card-frosted flex flex-col justify-between items-center text-center py-2.5 px-1 sm:py-3.5 sm:px-2 rounded-xl sm:rounded-2xl">
                <div>
                  <div class="text-[11px] sm:text-[13px] md:text-sm font-black uppercase text-white tracking-wider drop-shadow-sm">ӨЙЛӘ</div>
                  <div class="text-[10px] sm:text-xs text-slate-300 font-medium mt-0.5">Зухр</div>
                </div>
                <div class="text-base sm:text-xl md:text-2xl font-extrabold text-white tabular-time mt-3 drop-shadow">13:30</div>
              </div>

              <!-- 4. ИКЕНДЕ -->
              <div class="card-frosted flex flex-col justify-between items-center text-center py-2.5 px-1 sm:py-3.5 sm:px-2 rounded-xl sm:rounded-2xl">
                <div>
                  <div class="text-[11px] sm:text-[13px] md:text-sm font-black uppercase text-white tracking-wider drop-shadow-sm">ИКЕНДЕ</div>
                  <div class="text-[10px] sm:text-xs text-slate-300 font-medium mt-0.5">Аср</div>
                </div>
                <div class="text-base sm:text-xl md:text-2xl font-extrabold text-white tabular-time mt-3 drop-shadow">15:19</div>
              </div>

              <!-- 5. АХШАМ (ACTIVE ON FROSTED GLASS) -->
              <div class="card-frosted-active relative flex flex-col justify-between items-center text-center py-2.5 px-1 sm:py-3.5 sm:px-2 rounded-xl sm:rounded-2xl active-card-highlight scale-[1.02]">
                <span class="absolute -top-1.5 px-2 py-0.2 rounded-full bg-amber-400 text-[8px] font-black tracking-widest text-emerald-950 uppercase shadow-md">
                  Хәзер
                </span>
                <div>
                  <div class="text-[11px] sm:text-[13px] md:text-sm font-black uppercase text-amber-300 tracking-wider drop-shadow-sm">АХШАМ</div>
                  <div class="text-[10px] sm:text-xs text-emerald-200 font-medium mt-0.5">Магриб</div>
                </div>
                <div class="text-base sm:text-xl md:text-2xl font-extrabold text-white tabular-time mt-3 drop-shadow">17:30</div>
              </div>

              <!-- 6. ЯСТҮ (NEXT ON FROSTED GLASS) -->
              <div class="card-frosted-next relative flex flex-col justify-between items-center text-center py-2.5 px-1 sm:py-3.5 sm:px-2 rounded-xl sm:rounded-2xl">
                <div>
                  <div class="text-[11px] sm:text-[13px] md:text-sm font-black uppercase text-amber-300 tracking-wider drop-shadow-sm">ЯСТҮ</div>
                  <div class="text-[10px] sm:text-xs text-amber-200/80 font-medium mt-0.5">Иша</div>
                </div>
                <div class="text-base sm:text-xl md:text-2xl font-extrabold text-white tabular-time mt-3 drop-shadow">19:00</div>
              </div>

            </div>
          </div>
        </div>

        <div class="mt-3.5 sm:px-2 flex items-center justify-between text-[11px] text-slate-300/80 relative z-10">
          <span class="flex items-center gap-1.5">
            <span class="inline-block w-1.5 h-1.5 rounded-full bg-cyan-400"></span>
            <span>Матовое стекло • Backdrop blur 24px • Вектор типографика</span>
          </span>
          <span>Уфа вакыты (UTC+5)</span>
        </div>
      </div>
    </section>

  </main>

  <!-- Interactive Toast Notification -->
  <div id="toastNotification" class="fixed bottom-5 z-50 bg-emerald-900/95 text-white border border-emerald-400/50 backdrop-blur-md px-4 py-2.5 rounded-2xl text-xs font-semibold shadow-2xl transition-all duration-300 opacity-0 translate-y-4 pointer-events-none flex items-center gap-2">
    <svg class="w-4 h-4 text-emerald-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>
    </svg>
    <span id="toastMsg">Хәбәр сакланды!</span>
  </div>

  <script>
    // View Switcher logic (Both / Emerald only / Frosted only)
    const viewBothBtn = document.getElementById('viewBothBtn');
    const viewEmeraldBtn = document.getElementById('viewEmeraldBtn');
    const viewFrostedBtn = document.getElementById('viewFrostedBtn');
    const sectionEmerald = document.getElementById('sectionEmerald');
    const sectionFrosted = document.getElementById('sectionFrosted');

    const defaultBtnClass = "px-3 py-1.5 rounded-lg text-slate-300 hover:text-white transition";
    const activeBtnClass = "px-3 py-1.5 rounded-lg bg-emerald-600 text-white shadow-sm transition";

    viewBothBtn.addEventListener('click', () => {
      sectionEmerald.classList.remove('hidden');
      sectionFrosted.classList.remove('hidden');
      viewBothBtn.className = activeBtnClass;
      viewEmeraldBtn.className = defaultBtnClass;
      viewFrostedBtn.className = defaultBtnClass;
    });

    viewEmeraldBtn.addEventListener('click', () => {
      sectionEmerald.classList.remove('hidden');
      sectionFrosted.classList.add('hidden');
      viewEmeraldBtn.className = activeBtnClass;
      viewBothBtn.className = defaultBtnClass;
      viewFrostedBtn.className = defaultBtnClass;
    });

    viewFrostedBtn.addEventListener('click', () => {
      sectionEmerald.classList.add('hidden');
      sectionFrosted.classList.remove('hidden');
      viewFrostedBtn.className = activeBtnClass;
      viewBothBtn.className = defaultBtnClass;
      viewEmeraldBtn.className = defaultBtnClass;
    });

    // Copy to clipboard helper
    const btnCopy = document.getElementById('btnCopyData');
    const toast = document.getElementById('toastNotification');
    const toastMsg = document.getElementById('toastMsg');

    function showToast(text) {
      toastMsg.innerText = text;
      toast.classList.remove('opacity-0', 'translate-y-4');
      toast.classList.add('opacity-100', 'translate-y-0');
      setTimeout(() => {
        toast.classList.add('opacity-0', 'translate-y-4');
        toast.classList.remove('opacity-100', 'translate-y-0');
      }, 2500);
    }

    btnCopy.addEventListener('click', () => {
      const text = `Время намаза (Уфа)\nМиләди: 8 ноября 2026 г. • Якшәмбе\nҺиҗри: 27 Җөмадиәл-әүвәл 1448 г.х.\n\n` +
                   `1. Иртәнге (Фаджр): 06:53\n` +
                   `2. Кояш (Шурук): 08:33\n` +
                   `3. Өйлә (Зухр): 13:30\n` +
                   `4. Икенде (Аср): 15:19\n` +
                   `5. Ахшам (Магриб): 17:30\n` +
                   `6. Ястү (Иша): 19:00`;

      const tempTextArea = document.createElement('textarea');
      tempTextArea.value = text;
      tempTextArea.style.position = 'fixed';
      tempTextArea.style.left = '-9999px';
      document.body.appendChild(tempTextArea);
      tempTextArea.select();
      try {
        document.execCommand('copy');
        showToast('Намаз вакытлары күчерелде!');
      } catch (e) {
        showToast('Күчерү хатасы');
      }
      document.body.removeChild(tempTextArea);
    });

    // Real-time countdown to next prayer (Isha 19:00)
    function updateCountdown() {
      const now = new Date();
      const target = new Date();
      target.setHours(19, 0, 0, 0);

      let diff = target - now;
      if (diff <= 0) {
        target.setDate(target.getDate() + 1);
        target.setHours(6, 53, 0, 0);
        diff = target - now;
      }

      const h = Math.floor(diff / (1000 * 60 * 60));
      const m = Math.floor((diff / (1000 * 60)) % 60);
      const s = Math.floor((diff / 1000) % 60);

      const pad = (n) => String(n).padStart(2, '0');
      const timeStr = `${pad(h)}:${pad(m)}:${pad(s)}`;
      document.querySelectorAll('.live-timer').forEach(el => el.innerText = timeStr);
    }
    setInterval(updateCountdown, 1000);
    updateCountdown();
  </script>
</body>
</html>