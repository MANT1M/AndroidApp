                <span><strong class="font-bold text-emerald-300">Миләди:</strong> 8 ноября 2026 г.</span>
                <span class="text-emerald-400 font-bold">•</span>
                <span class="font-bold text-white tracking-wide">Якшәмбе</span>
                <span class="text-emerald-400 font-bold">•</span>
                <span><strong class="font-bold text-amber-300">Һиҗри:</strong> 27 Җөмадиәл-әүвәл 1448 г.х.</span>
              </div>
            </div>

            <!-- Next prayer countdown -->
            <div class="flex items-center gap-2.5 px-3 py-1.5 rounded-xl bg-black/35 border border-emerald-500/30 backdrop-blur-md text-xs self-start">
              <div class="flex flex-col text-right">
                <span class="text-[9px] uppercase tracking-wider font-bold text-amber-300">Киләсе: Ястү (Иша)</span>
                <span class="font-extrabold text-white tabular-time tracking-tight text-sm live-timer">00:34:12</span>
              </div>
              <span class="w-2.5 h-2.5 rounded-full bg-amber-400 animate-ping"></span>
            </div>
          </div>
        </div>

        <!-- 6 Prayers in One Single Row -->
        <div class="mt-4 sm:mt-5 sm:px-2">
          <div class="inner-capsule-white rounded-2xl sm:rounded-3xl p-2 sm:p-2.5 overflow-x-auto no-scrollbar">
            <div class="grid grid-cols-6 gap-1.5 sm:gap-2.5 min-w-[560px] sm:min-w-0">
              
              <!-- 1. ИРТӘНГЕ -->
              <div class="flex flex-col justify-between items-center text-center py-2.5 px-1 sm:py-3.5 sm:px-2 rounded-xl sm:rounded-2xl border border-slate-200/90 bg-slate-50/70 shadow-sm">
                <div>
                  <div class="text-[11px] sm:text-[13px] md:text-sm font-black uppercase text-emerald-950 tracking-wider">ИРТӘНГЕ</div>
                  <div class="text-[10px] sm:text-xs text-slate-500 font-medium mt-0.5">Фаджр</div>
                </div>
                <div class="text-base sm:text-xl md:text-2xl font-extrabold text-slate-900 tabular-time mt-3">06:53</div>
              </div>

              <!-- 2. КОЯШ -->
              <div class="flex flex-col justify-between items-center text-center py-2.5 px-1 sm:py-3.5 sm:px-2 rounded-xl sm:rounded-2xl border border-slate-200/90 bg-slate-50/70 shadow-sm">
                <div>
                  <div class="text-[11px] sm:text-[13px] md:text-sm font-black uppercase text-emerald-950 tracking-wider">КОЯШ</div>
                  <div class="text-[10px] sm:text-xs text-slate-500 font-medium mt-0.5">Шурук</div>
                </div>
                <div class="text-base sm:text-xl md:text-2xl font-extrabold text-slate-800 tabular-time mt-3">08:33</div>
              </div>

              <!-- 3. ӨЙЛӘ -->
              <div class="flex flex-col justify-between items-center text-center py-2.5 px-1 sm:py-3.5 sm:px-2 rounded-xl sm:rounded-2xl border border-slate-200/90 bg-slate-50/70 shadow-sm">
                <div>
                  <div class="text-[11px] sm:text-[13px] md:text-sm font-black uppercase text-emerald-950 tracking-wider">ӨЙЛӘ</div>
                  <div class="text-[10px] sm:text-xs text-slate-500 font-medium mt-0.5">Зухр</div>
                </div>
                <div class="text-base sm:text-xl md:text-2xl font-extrabold text-slate-900 tabular-time mt-3">13:30</div>
              </div>

              <!-- 4. ИКЕНДЕ -->
              <div class="flex flex-col justify-between items-center text-center py-2.5 px-1 sm:py-3.5 sm:px-2 rounded-xl sm:rounded-2xl border border-slate-200/90 bg-slate-50/70 shadow-sm">
                <div>
                  <div class="text-[11px] sm:text-[13px] md:text-sm font-black uppercase text-emerald-950 tracking-wider">ИКЕНДЕ</div>
                  <div class="text-[10px] sm:text-xs text-slate-500 font-medium mt-0.5">Аср</div>
                </div>
                <div class="text-base sm:text-xl md:text-2xl font-extrabold text-slate-900 tabular-time mt-3">15:19</div>
              </div>

              <!-- 5. АХШАМ (ACTIVE) -->
              <div class="relative flex flex-col justify-between items-center text-center py-2.5 px-1 sm:py-3.5 sm:px-2 rounded-xl sm:rounded-2xl bg-gradient-to-b from-[#093e2d] to-[#042419] border-2 border-amber-400 active-card-highlight shadow-lg scale-[1.02]">
                <span class="absolute -top-1.5 px-2 py-0.2 rounded-full bg-amber-400 text-[8px] font-black tracking-widest text-emerald-950 uppercase shadow">
                  Хәзер
                </span>
                <div>
                  <div class="text-[11px] sm:text-[13px] md:text-sm font-black uppercase text-amber-300 tracking-wider">АХШАМ</div>
                  <div class="text-[10px] sm:text-xs text-emerald-100 font-medium mt-0.5">Магриб</div>
                </div>
                <div class="text-base sm:text-xl md:text-2xl font-extrabold text-white tabular-time mt-3">17:30</div>
              </div>

              <!-- 6. ЯСТҮ (NEXT) -->
              <div class="relative flex flex-col justify-between items-center text-center py-2.5 px-1 sm:py-3.5 sm:px-2 rounded-xl sm:rounded-2xl bg-amber-50/70 border-2 border-amber-400 shadow-sm">
                <div>
                  <div class="text-[11px] sm:text-[13px] md:text-sm font-black uppercase text-amber-700 tracking-wider">ЯСТҮ</div>
                  <div class="text-[10px] sm:text-xs text-amber-900/60 font-medium mt-0.5">Иша</div>
                </div>
                <div class="text-base sm:text-xl md:text-2xl font-extrabold text-slate-900 tabular-time mt-3">19:00</div>
