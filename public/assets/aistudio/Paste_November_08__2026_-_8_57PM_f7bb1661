      </div>
    </section>

    <!-- ======================================================== -->
    <!-- ВАРИАНТ 2: МАТОВОЕ СТЕКЛО (FROSTED GLASS / GLASSMORPHISM)  -->
    <!-- ======================================================== -->
    <section id="sectionFrosted" class="w-full">
      <div class="flex items-center justify-between mb-2.5 px-2">
        <div class="flex items-center gap-2">
          <span class="px-2.5 py-0.5 rounded-full bg-cyan-900/60 border border-cyan-400/40 text-[11px] font-bold text-cyan-300 uppercase tracking-wider">Вариант 2</span>
          <span class="text-xs text-slate-300 font-medium">Премиум матовое стекло (Glassmorphism & Frosted Blur)</span>
        </div>
      </div>

      <div class="w-full widget-shell-frosted rounded-[28px] sm:rounded-[32px] p-4 sm:p-6 md:p-7 relative overflow-hidden">
        
        <!-- Subtle glass shine reflection at the top -->
        <div class="absolute -top-12 left-1/4 w-1/2 h-24 bg-white/20 rounded-full blur-2xl pointer-events-none"></div>

        <!-- Header: Title & Dates -->
        <div class="sm:px-2 relative z-10">
          <div class="flex items-start justify-between gap-3 flex-wrap">
            <div>
              <h2 class="text-xl sm:text-2xl md:text-3xl font-bold tracking-tight text-white flex items-center gap-2">
                <span class="text-amber-300 font-extrabold drop-shadow-[0_2px_12px_rgba(251,191,36,0.35)]">Время намаза</span>
                <span class="text-slate-200 font-medium">(Уфа)</span>
              </h2>

              <!-- Enlarged Miladi/Hijri Line on Frosted Glass -->
